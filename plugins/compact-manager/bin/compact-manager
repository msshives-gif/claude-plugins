#!/usr/bin/env python3
"""CLI for compact-manager managed mode."""
import os
import sys

# realpath, not abspath: a symlink onto PATH (~/.local/bin) must still
# find hooks/ next to the real install, not next to the link.
HOOKS = os.path.join(
    os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "hooks")
sys.path.insert(0, HOOKS)

try:
    import managed
except Exception as exc:
    print("compact-manager: import failed: %r" % (exc,), file=sys.stderr)
    sys.exit(1)

sys.exit(managed.cli_main())
