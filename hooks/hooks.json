{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/observer.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/observer.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/drain.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/drain.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\" || python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
